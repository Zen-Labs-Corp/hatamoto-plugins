{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hatamoto community plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "repo", "commit", "author", "license", "sdk"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$" },
    "repo": { "type": "string", "pattern": "^https://github\\.com/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "subdir": { "type": "string" },
    "author": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$" },
    "license": { "type": "string", "minLength": 1 },
    "sdk": { "type": "string" },
    "homepage": { "type": "string", "pattern": "^https://" }
  }
}
