{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hatamoto first-party theme manifest",
  "description": "manifests/themes/<name>.json. This repository lists first-party themes only: a git source whose repo owner is zenlabscorp or Zen-Labs-Corp (any case); archive sources are not accepted. Keep in sync with scripts/validate-theme-manifest.sh and the registry build. The validator alone judges about and features beyond shape (paragraph count, empty paragraph, edge space, URL, emoji and invisible characters, case-insensitive duplicate features; a trailing newline in about is also a validator-only reject).",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "author", "license", "archive_grant", "repo", "commit"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$", "not": { "enum": ["default", "webhooks", "hello", "gtm", "searchconsole"] } },
    "title": { "type": "string", "minLength": 1, "maxLength": 60, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f ]([^\\u0000-\\u001f\\u007f-\\u009f]*[^\\u0000-\\u001f\\u007f-\\u009f ])?$" },
    "about": { "type": "string", "minLength": 1, "maxLength": 1500, "pattern": "^[^\\u0000-\\u0009\\u000b-\\u001f\\u007f-\\u009f<>]+$" },
    "features": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f<>]+$" } },
    "author": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._@-]{0,60}$" },
    "license": { "enum": ["MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "ISC", "MPL-2.0", "GPL-2.0", "GPL-2.0-only", "GPL-2.0-or-later", "GPL-3.0", "GPL-3.0-only", "GPL-3.0-or-later", "LGPL-2.1", "LGPL-2.1-only", "LGPL-2.1-or-later", "LGPL-3.0", "LGPL-3.0-only", "LGPL-3.0-or-later", "AGPL-3.0", "AGPL-3.0-only", "AGPL-3.0-or-later"] },
    "archive_grant": { "const": true },
    "homepage": { "type": "string", "pattern": "^https://" },
    "subdir": { "type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._/-]+$" },
    "repo": { "type": "string", "pattern": "^https://github\\.com/([Zz][Ee][Nn][Ll][Aa][Bb][Ss][Cc][Oo][Rr][Pp]|[Zz][Ee][Nn]-[Ll][Aa][Bb][Ss]-[Cc][Oo][Rr][Pp])/[A-Za-z0-9._-]+$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "archive": { "type": "string", "pattern": "^https://([a-z0-9]([a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,}/[^\\s@]+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "not": { "anyOf": [{ "required": ["archive"] }, { "required": ["sha256"] }] }
}
